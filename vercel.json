{
  "rewrites": [
    {
      "source": "/:path((?!api).*)*",
      "destination": "/index.html"
    }
  ],
  "redirects": [
    {
      "source": "/(.*)",
      "destination": "https://qudemo.com/$1",
      "permanent": false,
      "has": [
        {
          "type": "host",
          "value": "qu-demo.vercel.app"
        }
      ]
    }
  ]
}
